{
 "doctype": "DocType",
 "name": "Heavy Equipment Rental Settings",
 "module": "Heavy Equipment Rental",
 "engine": "InnoDB",
 "issingle": 1,
 "istable": 0,
 "fields": [
  {
   "fieldname": "billing_tab",
   "fieldtype": "Tab Break",
   "label": "Billing Defaults"
  },
  {
   "fieldname": "billing_section",
   "fieldtype": "Section Break",
   "label": "Timesheet Defaults"
  },
  {
   "fieldname": "default_selling_uom",
   "fieldtype": "Select",
   "label": "Default Selling UOM",
   "options": "Hour\nDay\nMonth",
   "default": "Hour",
   "reqd": 1,
   "description": "Prefills the Billing Unit on new Timesheets. The selected Crane supplies its reference price for this unit; existing Assignment terms take precedence."
  },
  {
   "fieldname": "billing_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_supplier_uom",
   "fieldtype": "Select",
   "label": "Default Supplier Billing UOM",
   "options": "Hour\nDay\nMonth",
   "default": "Hour",
   "reqd": 1,
   "description": "Prefills the Supplier Billing UOM on new Timesheets. The Purchase Invoice uses that Timesheet unit and its entered purchase price."
  },
  {
   "fieldname": "shifts_tab",
   "fieldtype": "Tab Break",
   "label": "Day Shift"
  },
  {
   "fieldname": "shift_section",
   "fieldtype": "Section Break",
   "label": "Default Day Shift"
  },
  {
   "fieldname": "day_shift_start_time",
   "fieldtype": "Time",
   "label": "Default Day Shift Start",
   "default": "08:00:00",
   "reqd": 1
  },
  {
   "fieldname": "day_shift_end_time",
   "fieldtype": "Time",
   "label": "Default Day Shift End",
   "default": "16:00:00",
   "reqd": 1
  },
  {
   "fieldname": "hours_col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "day_shift_hours",
   "fieldtype": "Float",
   "label": "Default Day Shift Hours",
   "read_only": 1,
   "default": 8,
   "precision": "2",
   "description": "Calculated from the default start and end times."
  }
 ],
 "field_order": [
  "billing_tab",
  "billing_section",
  "default_selling_uom",
  "billing_column",
  "default_supplier_uom",
  "shifts_tab",
  "shift_section",
  "day_shift_start_time",
  "day_shift_end_time",
  "hours_col",
  "day_shift_hours"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "Projects Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "Projects User",
   "read": 1
  }
 ]
}
