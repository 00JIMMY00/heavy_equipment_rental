{
 "doctype": "DocType",
 "name": "Heavy Equipment Rental Settings",
 "module": "Heavy Equipment Rental",
 "engine": "InnoDB",
 "issingle": 1,
 "istable": 0,
 "fields": [
  {
   "fieldname": "billing_tab",
   "fieldtype": "Tab Break",
   "label": "Billing Defaults"
  },
  {
   "fieldname": "billing_section",
   "fieldtype": "Section Break",
   "label": "Timesheet Defaults"
  },
  {
   "fieldname": "default_selling_uom",
   "fieldtype": "Select",
   "label": "Default Selling UOM",
   "options": "Hour\nDay",
   "default": "Hour",
   "reqd": 1,
   "description": "Prefills the Billing Unit on new Timesheets. The selected Crane supplies its reference price for this unit; existing Rental Contract terms take precedence."
  },
  {
   "fieldname": "billing_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_supplier_uom",
   "fieldtype": "Select",
   "label": "Default Supplier Billing UOM",
   "options": "Hour\nDay",
   "default": "Hour",
   "reqd": 1,
   "description": "Prefills the Supplier Billing UOM on new Timesheets. The Purchase Invoice uses that Timesheet unit and its entered purchase price."
  },
  {
   "fieldname": "shifts_tab",
   "fieldtype": "Tab Break",
   "label": "Day Shift"
  },
  {
   "fieldname": "shift_section",
   "fieldtype": "Section Break",
   "label": "Default Day Shift"
  },
  {
   "fieldname": "day_shift_start_time",
   "fieldtype": "Time",
   "label": "Default Day Shift Start",
   "default": "08:00:00",
   "reqd": 1
  },
  {
   "fieldname": "day_shift_end_time",
   "fieldtype": "Time",
   "label": "Default Day Shift End",
   "default": "16:00:00",
   "reqd": 1
  },
  {
   "fieldname": "hours_col",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "day_shift_hours",
   "fieldtype": "Float",
   "label": "Default Day Shift Hours",
   "read_only": 1,
   "default": 8,
   "precision": "2",
   "description": "Calculated from the default start and end times."
  },
  {
   "fieldname": "rental_service_item",
   "fieldtype": "Link",
   "options": "Item",
   "label": "Rental Service Item",
   "description": "Shared non-stock Hour service for new Cranes. Existing Crane invoice Items are preserved."
  },
  {
   "fieldname": "native_workflow_migrated",
   "fieldtype": "Check",
   "hidden": 1,
   "read_only": 1,
   "default": "0",
   "label": "Native Workflow Migrated"
  },
  {
   "fieldname": "repairs_tab",
   "fieldtype": "Tab Break",
   "label": "Maintenance Defaults"
  },
  {
   "fieldname": "repair_defaults",
   "fieldtype": "Table",
   "label": "Repair Defaults by Company",
   "options": "HER Repair Defaults",
   "description": "Set the repair expense account and supplier payment method once per Company. Purchased parts use the Maintenance warehouse automatically."
  },
  {
   "fieldname": "driver_payroll_tab",
   "fieldtype": "Tab Break",
   "label": "Driver Payroll"
  },
  {
   "fieldname": "driver_payroll_defaults",
   "fieldtype": "Table",
   "label": "Driver Payroll Defaults by Company",
   "options": "HER Driver Payroll Defaults",
   "description": "The expense type sets the expense account. The Mode of Payment uses its default account for the Company to fund payroll."
  },
  {
   "fieldname": "expense_defaults_tab",
   "fieldtype": "Tab Break",
   "label": "Grouped Expenses"
  },
  {
   "fieldname": "expense_defaults",
   "fieldtype": "Table",
   "label": "Expense Defaults by Company",
   "options": "HER Expense Defaults"
  },
  {
   "fieldname": "holidays_tab",
   "fieldtype": "Tab Break",
   "label": "Holidays"
  },
  {
   "fieldname": "holiday_defaults",
   "fieldtype": "Table",
   "label": "Holiday Defaults",
   "options": "HER Holiday Default"
  },
  {
   "fieldname": "holiday_color",
   "fieldtype": "Color",
   "label": "Holiday Row Color",
   "default": "#E0A126"
  },
  {
   "fieldname": "zero_day_color",
   "fieldtype": "Color",
   "label": "Zero-Hour Row Color",
   "default": "#478BCA"
  },
  {
   "fieldname": "calculate_worked_hours",
   "fieldtype": "Check",
   "label": "Calculate Worked Hours from Shift Times",
   "default": "0",
   "description": "Recalculate all entries when saving a draft Timesheet. Overtime is entered separately."
  }
 ],
 "field_order": [
  "billing_tab",
  "billing_section",
  "default_selling_uom",
  "billing_column",
  "default_supplier_uom",
  "rental_service_item",
  "shifts_tab",
  "shift_section",
  "day_shift_start_time",
  "day_shift_end_time",
  "calculate_worked_hours",
  "hours_col",
  "day_shift_hours",
  "native_workflow_migrated",
  "holidays_tab",
  "holiday_defaults",
  "holiday_color",
  "zero_day_color",
  "repairs_tab",
  "repair_defaults",
  "driver_payroll_tab",
  "driver_payroll_defaults",
  "expense_defaults_tab",
  "expense_defaults"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "Projects Manager",
   "read": 1,
   "write": 1
  },
  {
   "role": "Projects User",
   "read": 1
  }
 ]
}
