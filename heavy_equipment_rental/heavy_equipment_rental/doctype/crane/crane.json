   "read_only_depends_on": "eval:!frappe.user.has_role(['Accounts Manager','System Manager'])"
  },
  {
   "fieldname": "settlement_approval",
   "fieldtype": "Select",
   "label": "Settlement Approval",
   "options": "Review Before Posting\nOn Invoice Submission",
   "default": "Review Before Posting",
   "depends_on": "enable_profit_sharing",
   "description": "Review costs before posting partner entitlements. Automatic approval is available only when costs are complete at invoicing."
  },
  {
   "fieldname": "distribution_posting",
   "fieldtype": "Select",
   "label": "Partner Entitlement Accounting",
   "options": "Source Revenue Accounts\nPartner Expense\nEquity Distribution",
   "default": "Partner Expense",
   "depends_on": "enable_profit_sharing",
   "description": "Use revenue reduction for agency arrangements; expense for contractual operating participation; equity only for approved company profit distributions. Select the treatment supported by the contract."
