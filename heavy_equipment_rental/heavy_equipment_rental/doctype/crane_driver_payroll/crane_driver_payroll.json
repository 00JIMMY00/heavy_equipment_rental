{
 "doctype": "DocType",
 "name": "Crane Driver Payroll",
 "module": "Heavy Equipment Rental",
 "istable": 1,
 "editable_grid": 1,
 "field_order": [
  "employee",
  "worked_hours",
  "overtime_hours",
  "rate",
  "overtime_price",
  "amount",
  "fixed_amount",
  "unit",
  "quantity",
  "mode_of_payment",
  "expense_entry",
  "grouped_expense"
 ],
 "fields": [
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Driver",
   "options": "Employee",
   "columns": 2,
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "worked_hours",
   "fieldtype": "Float",
   "label": "Total Hours",
   "precision": "6",
   "read_only": 1,
   "no_copy": 1,
   "columns": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "overtime_hours",
   "fieldtype": "Float",
   "label": "Overtime Hours",
   "precision": "6",
   "read_only": 1,
   "no_copy": 1,
   "columns": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "rate",
   "fieldtype": "Currency",
   "label": "Price / Unit",
   "precision": "9",
   "options": "Company:payroll_company:default_currency",
   "columns": 2,
   "in_list_view": 1
  },
  {
   "fieldname": "overtime_price",
   "fieldtype": "Currency",
   "label": "Overtime Price / Hour",
   "precision": "9",
   "options": "Company:payroll_company:default_currency",
   "columns": 2,
   "in_list_view": 1,
   "description": "Leave at zero to use the driver’s hourly price for overtime."
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Payroll Amount",
   "options": "Company:payroll_company:default_currency",
   "columns": 2,
   "in_list_view": 1,
   "print_hide": 1
  },
  {
   "fieldname": "fixed_amount",
   "fieldtype": "Check",
   "label": "Fixed Payroll Amount",
   "hidden": 1,
   "default": "0"
  },
  {
   "fieldname": "unit",
   "fieldtype": "Select",
   "label": "Payroll Unit",
   "options": "\nHour\nDay\nMonth",
   "read_only": 1
  },
  {
   "fieldname": "quantity",
   "fieldtype": "Float",
   "label": "Worked Quantity",
   "precision": "9",
   "columns": 2,
   "read_only": 1,
   "depends_on": "eval:doc.unit=='Day' || doc.unit=='Month'"
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "label": "Mode of Payment",
   "options": "Mode of Payment"
  },
  {
   "fieldname": "expense_entry",
   "fieldtype": "Link",
   "label": "Expense Entry",
   "options": "Expense Entry",
   "read_only": 1,
   "no_copy": 1,
   "hidden": 1
  },
  {
   "fieldname": "grouped_expense",
   "fieldtype": "Link",
   "label": "Grouped Expense",
   "options": "Grouped Expense",
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "permissions": []
}
