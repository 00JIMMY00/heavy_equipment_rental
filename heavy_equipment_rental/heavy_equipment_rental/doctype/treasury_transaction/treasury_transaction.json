{
 "doctype": "DocType",
 "name": "Treasury Transaction",
 "module": "Heavy Equipment Rental",
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "is_submittable": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "TRE-.YYYY.-.#####",
   "default": "TRE-.YYYY.-.#####",
   "reqd": 1,
   "hidden": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "read_only": 1,
   "fetch_from": "company.default_currency"
  },
  {
   "fieldname": "transfer_section",
   "fieldtype": "Section Break",
   "label": "Transfer"
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "label": "Mode of Payment",
   "options": "Mode of Payment",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source_account",
   "fieldtype": "Link",
   "label": "Source Account",
   "options": "Account",
   "read_only": 1,
   "description": "The default account for the selected Mode of Payment and Company."
  },
  {
   "fieldname": "transfer_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "destination_account",
   "fieldtype": "Link",
   "label": "Destination Account",
   "options": "Account",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "options": "currency",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "reference_section",
   "fieldtype": "Section Break",
   "label": "Reference"
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference Number"
  },
  {
   "fieldname": "reference_date",
   "fieldtype": "Date",
   "label": "Reference Date"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "journal_entry",
   "fieldtype": "Link",
   "label": "Journal Entry",
   "options": "Journal Entry",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Treasury Transaction",
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "field_order": [
  "naming_series",
  "company",
  "posting_date",
  "currency",
  "transfer_section",
  "mode_of_payment",
  "source_account",
  "transfer_column",
  "destination_account",
  "amount",
  "reference_section",
  "reference_no",
  "reference_date",
  "description",
  "journal_entry",
  "amended_from"
 ],
 "permissions": [
  {
   "role": "Accounts User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "print": 1,
   "export": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "print": 1,
   "export": 1
  },
  {
   "role": "Auditor",
   "read": 1,
   "report": 1,
   "print": 1
  }
 ]
}
