{
 "doctype": "DocType",
 "name": "Expense Entry",
 "module": "Jimmy Cranes",
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "project",
 "search_fields": "project,expense_type,crane,employee",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "EXP-.#####",
   "default": "EXP-.#####",
   "reqd": 1,
   "hidden": 1
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Crane Project",
   "options": "Crane Project",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Expense Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "expense_type",
   "fieldtype": "Link",
   "label": "Expense Type",
   "options": "Expense Type",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1,
   "non_negative": 1
  },
  {
   "fieldname": "crane",
   "fieldtype": "Link",
   "label": "Crane",
   "options": "Crane",
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Crane Driver (Employee)",
   "options": "Employee",
   "in_standard_filter": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "receipt",
   "fieldtype": "Attach",
   "label": "Receipt"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Expense Entry",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "field_order": [
  "naming_series",
  "project",
  "posting_date",
  "expense_type",
  "amount",
  "crane",
  "employee",
  "description",
  "receipt",
  "amended_from"
